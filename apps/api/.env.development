# Local dev defaults for the API. Matches the db credentials/port in docker-compose.yml.
# Loaded automatically by `npm run dev` (see package.json's `--env-file` flag).
PORT=3001
DATABASE_URL=postgres://titantrack:titantrack@localhost:5433/titantrack

# How often (ms) the API re-checks the scraper's output file for new course data.
COURSE_DATA_SYNC_INTERVAL_MS=900000

# How long (ms) getCourses() results are cached per filter combination.
COURSES_CACHE_TTL_MS=60000
